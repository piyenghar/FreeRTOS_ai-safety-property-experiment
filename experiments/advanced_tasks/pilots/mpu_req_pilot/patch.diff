+static char * prvAppendDecimal( char * pcOut,
+                                uint8_t ucVal )
+{
+    char acDigits[ 3 ];
+    int iCount = 0;
+    int i;
+    uint8_t ucTmp = ucVal;
+
+    do
+    {
+        acDigits[ iCount ] = ( char ) ( '0' + ( ucTmp % 10u ) );
+        iCount++;
+        ucTmp = ( uint8_t ) ( ucTmp / 10u );
+    } while( ucTmp > 0u );
+
+    for( i = iCount - 1; i >= 0; i-- )
+    {
+        *pcOut = acDigits[ i ];
+        pcOut++;
+    }
+
+    return pcOut;
+}
+/*-----------------------------------------------------------*/
+
+static void prvReportRequestOutcome( uint8_t ucRequested,
+                                     uint8_t ucState,
+                                     uint8_t ucObserved )
+{
+    char pcLine[ 48 ];
+    char * pc = pcLine;
+    const char * pcPrefix = "MPU_REQ: req=";
+    const char * pcMid;
+    const char * pcObs = " observed=";
+
+    while( *pcPrefix != '\0' )
+    {
+        *pc = *pcPrefix;
+        pc++;
+        pcPrefix++;
+    }
+
+    pc = prvAppendDecimal( pc, ucRequested );
+    *pc = ' ';
+    pc++;
+
+    if( ucState == REQ_STATE_ACCEPTED )
+    {
+        pcMid = "ACCEPT";
+    }
+    else if( ucState == REQ_STATE_REJECTED )
+    {
+        pcMid = "REJECT";
+    }
+    else
+    {
+        pcMid = "PENDING";
+    }
+
+    while( *pcMid != '\0' )
+    {
+        *pc = *pcMid;
+        pc++;
+        pcMid++;
+    }
+
+    while( *pcObs != '\0' )
+    {
+        *pc = *pcObs;
+        pc++;
+        pcObs++;
+    }
+
+    pc = prvAppendDecimal( pc, ucObserved );
+    *pc = '\0';
+    prvReportPropertyResult( pcLine );
+}
