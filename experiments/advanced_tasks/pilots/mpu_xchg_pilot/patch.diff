+static void prvReportObservedSharedValue( uint8_t ucVal )
+{
+    char pcLine[ 28 ];
+    char * pc = pcLine;
+    const char * pcPrefix = "MPU_XCHG: observed=";
+    uint8_t ucTmp;
+    char acDigits[ 3 ];
+    int iDigitCount = 0;
+    int i;
+
+    while( *pcPrefix != '\0' )
+    {
+        *pc = *pcPrefix;
+        pc++;
+        pcPrefix++;
+    }
+
+    ucTmp = ucVal;
+
+    do
+    {
+        acDigits[ iDigitCount ] = ( char ) ( '0' + ( ucTmp % 10u ) );
+        iDigitCount++;
+        ucTmp = ( uint8_t ) ( ucTmp / 10u );
+    } while( ucTmp > 0u );
+
+    for( i = iDigitCount - 1; i >= 0; i-- )
+    {
+        *pc = acDigits[ i ];
+        pc++;
+    }
+
+    *pc = '\0';
+    prvReportPropertyResult( pcLine );
+}
