+/**
+ * @brief Report an observed shared-memory value for the MPU exchange pilot.
+ *
+ * Format: "MPU_XCHG: observed=<decimal>" — used to prove the RO task sees
+ * updates written by the RW task. Stack-local buffer only (MPU-legal).
+ */
+static void prvReportObservedSharedValue( uint8_t ucVal );
