 static void prvReportPropertyResult( const char * pcMessage );
 
+/**
+ * @brief Print "T3_CYCLE: <ulCycle>" on UART0.
+ *
+ * The message is built in a buffer on the caller's (task) stack because the
+ * unprivileged read-only task has no write access to BSS/data globals.
+ */
+static void prvReportCycleCount( uint32_t ulCycle );
+
+/*-----------------------------------------------------------*/
+
+static void prvReportCycleCount( uint32_t ulCycle )
+{
+    static const char pcPrefix[] = "T3_CYCLE: ";
+    char cMessage[ sizeof( pcPrefix ) + 10 ];
+    char cDigits[ 10 ];
+    uint32_t ulIndex = 0;
+    uint32_t ulDigitCount = 0;
+
+    while( pcPrefix[ ulIndex ] != '\0' )
+    {
+        cMessage[ ulIndex ] = pcPrefix[ ulIndex ];
+        ulIndex++;
+    }
+
+    do
+    {
+        cDigits[ ulDigitCount ] = ( char ) ( '0' + ( ulCycle % 10U ) );
+        ulDigitCount++;
+        ulCycle /= 10U;
+    } while( ulCycle != 0U );
+
+    while( ulDigitCount > 0U )
+    {
+        ulDigitCount--;
+        cMessage[ ulIndex ] = cDigits[ ulDigitCount ];
+        ulIndex++;
+    }
+
+    cMessage[ ulIndex ] = '\0';
+
+    prvReportPropertyResult( cMessage );
+}
 /*-----------------------------------------------------------*/
 
 static void prvReportPropertyResult( const char * pcMessage )
