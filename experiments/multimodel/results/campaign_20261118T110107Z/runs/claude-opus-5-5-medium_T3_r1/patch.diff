 {
     uint8_t ucVal;
 
+    /* Completed SP1/SP2 cycles. Kept on the task stack: this unprivileged task
+     * cannot write BSS globals. */
+    uint32_t ulCompletedCycles = 0;
+
     /* Unused parameters. */
     ( void ) pvParameters;
 
@@ -220,6 +266,9 @@ static void prvROAccessTask( void * pvParameters )
         }
         #endif /* #if( configENFORCE_SYSTEM_CALLS_FROM_KERNEL_ONLY == 1 ) */
 
+        ulCompletedCycles++;
+        prvReportCycleCount( ulCompletedCycles );
+
         /* Wait for a second. */
         vTaskDelay( pdMS_TO_TICKS( 1000 ) );
     }
