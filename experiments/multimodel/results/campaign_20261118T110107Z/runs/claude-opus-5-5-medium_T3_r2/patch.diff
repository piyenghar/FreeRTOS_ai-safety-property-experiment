+/**
+ * @brief Print "T3_CYCLE: <ulCycle>" on UART0.
+ *
+ * The message is formatted in a buffer on the caller's task stack because the
+ * unprivileged read-only task cannot write BSS/data globals or use the C
+ * library formatting functions.
+ */
+static void prvReportCycleCount( uint32_t ulCycle );
