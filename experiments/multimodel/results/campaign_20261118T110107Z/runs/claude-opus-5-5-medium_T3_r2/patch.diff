+static void prvReportCycleCount( uint32_t ulCycle )
+{
+    static const char cPrefix[] = "T3_CYCLE: ";
+    char cDigits[ 10 ];
+    char cMessage[ sizeof( cPrefix ) + sizeof( cDigits ) ];
+    uint32_t ulDigitCount = 0;
+    uint32_t ulIndex = 0;
+    uint32_t i;
+
+    do
+    {
+        cDigits[ ulDigitCount ] = ( char ) ( '0' + ( ulCycle % 10UL ) );
+        ulDigitCount++;
+        ulCycle /= 10UL;
+    } while( ulCycle != 0UL );
+
+    for( i = 0; i < ( sizeof( cPrefix ) - 1U ); i++ )
+    {
+        cMessage[ ulIndex ] = cPrefix[ i ];
+        ulIndex++;
+    }
+
+    while( ulDigitCount > 0UL )
+    {
+        ulDigitCount--;
+        cMessage[ ulIndex ] = cDigits[ ulDigitCount ];
+        ulIndex++;
+    }
+
+    cMessage[ ulIndex ] = '\0';
+
+    prvReportPropertyResult( cMessage );
+}
