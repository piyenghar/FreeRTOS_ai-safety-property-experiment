+/**
+ * @brief Print "T3_CYCLE: <n>" on UART0.
+ *
+ * The message is formatted in a buffer on the caller's stack because the
+ * unprivileged RO task cannot write BSS/data globals.
+ */
+static void prvReportCycleCount( uint32_t ulCycle );
+
+/*-----------------------------------------------------------*/
+
+static void prvReportCycleCount( uint32_t ulCycle )
+{
+    static const char cPrefix[] = "T3_CYCLE: ";
+    char cBuffer[ sizeof( cPrefix ) + 10 ];
+    char cDigits[ 10 ];
+    uint32_t ulIndex = 0;
+    uint32_t ulDigitCount = 0;
+
+    while( cPrefix[ ulIndex ] != '\0' )
+    {
+        cBuffer[ ulIndex ] = cPrefix[ ulIndex ];
+        ulIndex++;
+    }
+
+    do
+    {
+        cDigits[ ulDigitCount ] = ( char ) ( '0' + ( ulCycle % 10U ) );
+        ulDigitCount++;
+        ulCycle /= 10U;
+    } while( ulCycle != 0U );
+
+    while( ulDigitCount > 0U )
+    {
+        ulDigitCount--;
+        cBuffer[ ulIndex ] = cDigits[ ulDigitCount ];
+        ulIndex++;
+    }
+
+    cBuffer[ ulIndex ] = '\0';
+
+    prvReportPropertyResult( cBuffer );
+}
 /*-----------------------------------------------------------*/
 
 static void prvReportPropertyResult( const char * pcMessage )
