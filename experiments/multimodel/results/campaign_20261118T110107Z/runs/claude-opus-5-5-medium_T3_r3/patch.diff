+    /* Lives on this task's MPU-protected stack, which is the only RAM (besides
+     * ucROTaskFaultTracker) this unprivileged task may write. */
+    uint32_t ulCycleCount = 0;
+
     /* Unused parameters. */
     ( void ) pvParameters;
 
@@ -220,6 +266,9 @@ static void prvROAccessTask( void * pvParameters )
