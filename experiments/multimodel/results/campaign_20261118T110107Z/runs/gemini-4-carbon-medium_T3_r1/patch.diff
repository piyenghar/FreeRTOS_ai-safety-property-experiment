+static void prvReportCycleCount( uint32_t ulCycleCount )
+{
+    const char * pcPrefix = "T3_CYCLE: ";
+    char cMessage[ 24 ];
+    char cDigits[ 10 ];
+    uint32_t ulIndex = 0U;
+    uint32_t ulDigitCount = 0U;
+    uint32_t ulRemaining = ulCycleCount;
+
+    while( pcPrefix[ ulIndex ] != '\0' )
+    {
+        cMessage[ ulIndex ] = pcPrefix[ ulIndex ];
+        ulIndex++;
+    }
+
+    do
+    {
+        uint32_t ulQuotient = ulRemaining / 10U;
+        uint32_t ulDigit = ulRemaining - ( ulQuotient * 10U );
+
+        cDigits[ ulDigitCount ] = ( char ) ( '0' + ( char ) ulDigit );
+        ulDigitCount++;
+        ulRemaining = ulQuotient;
+    } while( ulRemaining > 0U );
+
+    while( ulDigitCount > 0U )
+    {
+        ulDigitCount--;
+        cMessage[ ulIndex ] = cDigits[ ulDigitCount ];
+        ulIndex++;
+    }
+
+    cMessage[ ulIndex ] = '\0';
+    prvReportPropertyResult( cMessage );
+}
