+static void prvReportCycleCount( uint32_t ulCycle )
+{
+    char cMessage[ 24 ];
+    char cDigits[ 10 ];
+    const char * pcPrefix = "T3_CYCLE: ";
+    uint32_t ulIdx = 0UL;
+    uint32_t ulDigitCount = 0UL;
+
+    while( *pcPrefix != '\0' )
+    {
+        cMessage[ ulIdx ] = *pcPrefix;
+        ulIdx++;
+        pcPrefix++;
+    }
+
+    if( ulCycle == 0UL )
+    {
+        cDigits[ ulDigitCount ] = '0';
+        ulDigitCount++;
+    }
+    else
+    {
+        while( ulCycle > 0UL )
+        {
+            cDigits[ ulDigitCount ] = ( char ) ( ( uint32_t ) '0' + ( ulCycle % 10UL ) );
+            ulDigitCount++;
+            ulCycle /= 10UL;
+        }
+    }
+
+    while( ulDigitCount > 0UL )
+    {
+        ulDigitCount--;
+        cMessage[ ulIdx ] = cDigits[ ulDigitCount ];
+        ulIdx++;
+    }
+
+    cMessage[ ulIdx ] = '\0';
+    prvReportPropertyResult( cMessage );
+}
