+/**
+ * @brief Format and print the completed SP1/SP2 cycle count on UART0 using
+ * only stack-local storage accessible to the unprivileged task.
+ *
+ * @param ulCycle[in] Completed cycle count to report.
+ */
+static void prvReportCycleCount( uint32_t ulCycle );
