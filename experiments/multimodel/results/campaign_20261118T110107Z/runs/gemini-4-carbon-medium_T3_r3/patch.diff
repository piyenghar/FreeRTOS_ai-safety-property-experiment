+/**
+ * @brief Format and print the completed SP1/SP2 test cycle count on UART0.
+ *
+ * Uses only stack-local buffers and Flash string literals so it executes safely
+ * inside an unprivileged MPU task without touching BSS/data globals.
+ */
+static void prvReportCycleCount( uint32_t ulCycle );
