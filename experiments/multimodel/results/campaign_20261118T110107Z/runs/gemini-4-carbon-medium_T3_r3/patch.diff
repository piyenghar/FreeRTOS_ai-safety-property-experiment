+static void prvReportCycleCount( uint32_t ulCycle )
+{
+    char cMessage[ 24 ];
+    char cDigits[ 10 ];
+    uint32_t ulDigitCount = 0U;
+    uint32_t ulIdx = 0U;
+    const char * pcPrefix = "T3_CYCLE: ";
+
+    while( *pcPrefix != '\0' )
+    {
+        cMessage[ ulIdx ] = *pcPrefix;
+        ulIdx++;
+        pcPrefix++;
+    }
+
+    if( ulCycle == 0U )
+    {
+        cMessage[ ulIdx ] = '0';
+        ulIdx++;
+    }
+    else
+    {
+        while( ulCycle > 0U )
+        {
+            cDigits[ ulDigitCount ] = ( char ) ( '0' + ( ulCycle % 10U ) );
+            ulDigitCount++;
+            ulCycle /= 10U;
+        }
+
+        while( ulDigitCount > 0U )
+        {
+            ulDigitCount--;
+            cMessage[ ulIdx ] = cDigits[ ulDigitCount ];
+            ulIdx++;
+        }
+    }
+
+    cMessage[ ulIdx ] = '\0';
+    prvReportPropertyResult( cMessage );
+}
