+static void prvVerifyProtectedWriteIsRejected( const char * pcPassMessage,
+                                               const char * pcFailMessage )
+{
+    ucExpectedFaultTracker[ 0 ] = FAULT_TRACKER_ARMED;
+
+    /* This task only has read access, so the MPU must reject this write. */
+    ucSharedMemory[ 0 ] = 0;
+
+    if( ucExpectedFaultTracker[ 0 ] == FAULT_TRACKER_CLEAR )
+    {
+        prvReportPropertyResult( pcPassMessage );
+    }
+    else
+    {
+        prvReportPropertyResult( pcFailMessage );
+    }
+}
