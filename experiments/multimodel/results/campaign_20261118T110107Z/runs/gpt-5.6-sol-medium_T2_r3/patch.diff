+/*-----------------------------------------------------------*/
+
+static BaseType_t prvProtectedWriteWasRejected( void )
+{
+    /* Tell the Memory Fault handler that the following access is expected. */
+    ucROTaskFaultTracker[ 0 ] = 1;
+
+    /* The read-only task's MPU permissions must reject this write. */
+    ucSharedMemory[ 0 ] = 0;
+
+    /* The handler clears the tracker after recovering from the fault. */
+    return ( ucROTaskFaultTracker[ 0 ] == 0 ) ? pdTRUE : pdFALSE;
+}
