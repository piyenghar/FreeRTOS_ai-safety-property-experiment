+static void prvReportCycle( uint32_t ulCycleCount )
+{
+    char pcMessage[ 22 ] = "T3_CYCLE: ";
+    uint32_t ulDivisor = 1;
+    uint32_t ulIndex = 10;
+
+    while( ( ulCycleCount / ulDivisor ) >= 10UL )
+    {
+        ulDivisor *= 10UL;
+    }
+
+    do
+    {
+        pcMessage[ ulIndex ] = ( char ) ( '0' + ( ulCycleCount / ulDivisor ) );
+        ulIndex++;
+        ulCycleCount %= ulDivisor;
+        ulDivisor /= 10UL;
+    } while( ulDivisor != 0UL );
+
+    pcMessage[ ulIndex ] = '\0';
+    prvReportPropertyResult( pcMessage );
+}
