+static void prvReportCycle( uint32_t ulCycleCount )
+{
+    char cMessage[ 22 ] = "T3_CYCLE: ";
+    char * pcNextDigit = &( cMessage[ 10 ] );
+    uint32_t ulDivisor = 1;
+
+    while( ( ulCycleCount / ulDivisor ) >= 10U )
+    {
+        ulDivisor *= 10U;
+    }
+
+    do
+    {
+        *pcNextDigit = ( char ) ( '0' + ( ulCycleCount / ulDivisor ) );
+        pcNextDigit++;
+        ulCycleCount %= ulDivisor;
+        ulDivisor /= 10U;
+    } while( ulDivisor != 0U );
+
+    *pcNextDigit = '\0';
+    prvReportPropertyResult( cMessage );
+}
