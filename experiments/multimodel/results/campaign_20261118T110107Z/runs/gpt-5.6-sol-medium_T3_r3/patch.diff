+/**
+ * @brief Report the number of completed SP1/SP2 test cycles on UART0.
+ *
+ * The counter and conversion buffer are task-stack local so the unprivileged
+ * task does not need write access to BSS.
+ */
+static void prvReportCycle( uint32_t ulCycleCount );
