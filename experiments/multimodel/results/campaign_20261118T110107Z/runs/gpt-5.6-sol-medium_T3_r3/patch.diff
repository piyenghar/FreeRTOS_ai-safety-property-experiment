+static void prvReportCycle( uint32_t ulCycleCount )
+{
+    static const char pcPrefix[] = "T3_CYCLE: ";
+    volatile uint32_t * const pulUartData = ( volatile uint32_t * ) 0x40004000UL;
+    char pcDigits[ 10 ];
+    uint32_t ulDigitCount = 0;
+    const char * pcPrefixCharacter = pcPrefix;
+
+    while( *pcPrefixCharacter != '\0' )
+    {
+        *pulUartData = ( uint32_t ) ( ( uint8_t ) *pcPrefixCharacter );
+        pcPrefixCharacter++;
+    }
+
+    do
+    {
+        pcDigits[ ulDigitCount ] = ( char ) ( '0' + ( ulCycleCount % 10UL ) );
+        ulDigitCount++;
+        ulCycleCount /= 10UL;
+    } while( ulCycleCount != 0UL );
+
+    while( ulDigitCount > 0UL )
+    {
+        ulDigitCount--;
+        *pulUartData = ( uint32_t ) ( ( uint8_t ) pcDigits[ ulDigitCount ] );
+    }
+
+    *pulUartData = ( uint32_t ) '\n';
+}
